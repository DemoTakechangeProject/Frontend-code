select st.roll,st.sname as student_name,sb.sid,sb.sname as subject_name
from student st
inner join student_subject ss
on st.roll = ss.roll
inner join subject sb
on sb.sid = ss.sid
where sb.sname = 'Java' and sb.sname='Dot net';

